{
  "_comment": "Order: spam -> skip; bare @tag -> skip; emoji only -> one emoji; customer-issue templates (alert) -> short reply + Discord; criticism -> no reply + Discord; other templates (max two); agreement; praise; unmatched question -> Discord; anything else -> one emoji. Triggers are case-insensitive regular expressions. The bot never uses 🤔 or 🤫.",
  "templates": [
    {
      "id": "damaged",
      "triggers": [
        "damaged",
        "broken",
        "defective",
        "arrived (ripped|torn|bent|cracked)"
      ],
      "alert": true,
      "reply": "sorry about that. please DM us your order number and photos of the damage so the team can check."
    },
    {
      "id": "where_is_my_order",
      "triggers": [
        "where('?s| is) my (order|package|print|canvas)",
        "order status",
        "haven'?t (received|gotten|got)",
        "never (arrived|received|came)",
        "missing (order|package)",
        "still (waiting|haven'?t)"
      ],
      "alert": true,
      "reply": "sorry about that. please DM us your order number so the team can check."
    },
    {
      "id": "tracking",
      "triggers": [
        "track(ing)?\\b",
        "tracking number",
        "track my order"
      ],
      "alert": true,
      "reply": "you get tracking details once your order ships. if something's off, DM us your order number."
    },
    {
      "id": "return",
      "triggers": [
        "\\breturns?\\b",
        "exchange",
        "refund"
      ],
      "alert": true,
      "reply": "please DM us your order number and we'll go through the options with you."
    },
    {
      "id": "custom_size",
      "triggers": [
        "custom size",
        "different (size|dimensions)",
        "(bigger|larger|smaller) (size|version|one)",
        "other sizes?"
      ],
      "alert": true,
      "reply": "DM us the artwork and the size you have in mind. we'll check what's possible.",
      "excludes": [
        "custom",
        "sizes"
      ]
    },
    {
      "id": "custom",
      "triggers": [
        "custom",
        "personali[sz]",
        "customi[sz]",
        "my own (design|photo|picture)"
      ],
      "alert": true,
      "reply": "DM us your idea. we'll let you know what's possible."
    },
    {
      "id": "bulk",
      "triggers": [
        "bulk",
        "wholesale",
        "multiple prints",
        "for (our|the) (office|business|company|store)"
      ],
      "alert": true,
      "reply": "DM us the artworks and quantities. the team will get back to you."
    },
    {
      "id": "discount",
      "triggers": [
        "discount",
        "promo",
        "coupon",
        "\\bsale\\b",
        "\\bdeal\\b",
        "\\bcode\\b"
      ],
      "reply": "current offers are in the link in bio 👀"
    },
    {
      "id": "digital",
      "triggers": [
        "digital",
        "download",
        "printable",
        "\\bpdf\\b",
        "\\bfile\\b"
      ],
      "reply": "selected artworks are available as digital downloads. link in bio 👀"
    },
    {
      "id": "framed",
      "triggers": [
        "\\bframe[ds]?\\b",
        "framing"
      ],
      "reply": "yes. black, white or wood frames. link in bio 👀"
    },
    {
      "id": "canvas_or_poster",
      "triggers": [
        "canvas",
        "poster",
        "material",
        "\\bpaper\\b"
      ],
      "reply": "thin canvas, thick canvas, framed or poster. link in bio 👀"
    },
    {
      "id": "sizes",
      "triggers": [
        "\\bsizes?\\b",
        "dimensions?",
        "how big",
        "measurements?",
        "\\bwhat size"
      ],
      "reply": "from 18x12\" up to 60x40\", depending on the artwork. link in bio 👀"
    },
    {
      "id": "price",
      "triggers": [
        "price",
        "pricing",
        "how much",
        "\\bcost",
        "\\bprecio",
        "\\bpreis",
        "\\bprix\\b",
        "\\bkaina"
      ],
      "reply": "depends on the size and finish. current prices are in the link in bio."
    },
    {
      "id": "usa",
      "triggers": [
        "\\busa\\b",
        "united states",
        "america",
        "\\bto (the )?us\\b",
        "\\bin (the )?us\\b",
        "\\bus shipping"
      ],
      "reply": "yes. the usa is our main market. link in bio 👀"
    },
    {
      "id": "shipping_time",
      "triggers": [
        "how long",
        "delivery time",
        "shipping time",
        "when (will|would|does) .*(arrive|ship|come)",
        "how (fast|quick)"
      ],
      "reply": "every piece is made to order, so it depends on your location. you get tracking once it ships."
    },
    {
      "id": "worldwide",
      "triggers": [
        "worldwide",
        "international",
        "ship(ping)? to",
        "deliver(y)? to",
        "do you ship",
        "\\bship\\b",
        "do you (ship|deliver)",
        "\\bdeliver(y)?\\??$",
        "ship(ping)? (here|outside|abroad)"
      ],
      "reply": "which country are you ordering from?"
    },
    {
      "id": "quality",
      "triggers": [
        "quality",
        "high res",
        "resolution",
        "is it (good|legit)",
        "\\blegit\\b"
      ],
      "reply": "high-res printing on quality materials. built to last. 🫡"
    },
    {
      "id": "recommend",
      "triggers": [
        "recommend",
        "best ?seller",
        "which one",
        "most popular"
      ],
      "reply": "depends on the energy you want in the room. link in bio 👀"
    },
    {
      "id": "where_to_buy",
      "triggers": [
        "where (can|do|to|could) (i|we|you)? ?(buy|get|order|find|purchase)",
        "\\blink\\b",
        "\\bshop\\b",
        "purchase",
        "\\bbuy\\b",
        "(need|want) (this|one|it|that)",
        "\\bavailable\\b",
        "how (do|can) i (get|order)",
        "\\bsell\\b",
        "where (to|do i|can i|should i) go",
        "\\baccess to (these|this|them|it)\\b",
        "where (are|is) (these|this|they|it) (sold|from)"
      ],
      "reply": "link in bio 👀"
    },
    {
      "id": "support",
      "triggers": [
        "support",
        "contact",
        "\\bhelp\\b",
        "customer service",
        "email"
      ],
      "alert": true,
      "reply": "DM us your question and order number if you have one. the team will help."
    },
    {
      "id": "suggestion",
      "triggers": [
        "make (a|one|this|it) ?(version|one)? ?(with|of|for)",
        "(do|make) one (with|of|for)",
        "can you (make|do) (one|a|this)",
        "you should (make|do)",
        "version (with|of)"
      ],
      "reply": "noted. 🫡"
    },
    {
      "id": "fandom",
      "triggers": [
        "\\bgoat\\b",
        "🐐",
        "\\blegend",
        "\\bmamba\\b",
        "\\bgoated\\b"
      ],
      "reply": "🐐"
    }
  ],
  "agreement": {
    "_comment": "agreement with the message -> short agreement, no CTA",
    "triggers": [
      "\\bfacts\\b",
      "so true",
      "\\bexactly\\b",
      "\\bcorrect\\b",
      "\\bagree",
      "\\balways\\b",
      "locked in",
      "lock(ed)? in",
      "\\btrue\\b",
      "\\bfr\\b",
      "💯"
    ],
    "replies": [
      "💯",
      "always. 🫡",
      "exactly.",
      "💯💯"
    ]
  },
  "praise": {
    "enabled": true,
    "triggers": [
      "love",
      "amazing",
      "beautiful",
      "\\bfire\\b",
      "\\bhard\\b",
      "\\bsick\\b",
      "\\bdope\\b",
      "\\bclean\\b",
      "motivat",
      "inspir",
      "great",
      "awesome",
      "nice",
      "perfect",
      "\\bwow\\b",
      "🔥",
      "❤",
      "😍",
      "👏",
      "💯",
      "🙌",
      "💪",
      "😮",
      "🤩",
      "♥",
      "respect",
      "🫡",
      "💵",
      "🖤",
      "👊"
    ],
    "replies": [
      "appreciate you. 🫡",
      "means a lot.",
      "thank you for being here.",
      "appreciate the support. 🙌",
      "🫡",
      "🙌",
      "🖤"
    ]
  },
  "criticism": {
    "_comment": "complaints, corrections, AI/originality questions: never an emoji or CTA; no reply, sent to Discord for a person",
    "triggers": [
      "\\bwrong\\b",
      "supposed to be",
      "\\bmistake",
      "\\bugly\\b",
      "\\btrash\\b",
      "\\bfake\\b",
      "\\bscam",
      "\\bstole",
      "\\bcopy\\b",
      "copied",
      "\\bai\\b",
      "a\\.i\\.",
      "artificial",
      "not (his|her|the|a|real)",
      "isn'?t (his|her|real)",
      "doesn'?t look",
      "looks off",
      "\\bcringe\\b",
      "\\bwack\\b",
      "\\bmid\\b",
      "\\bterrible\\b",
      "\\bawful\\b",
      "\\bworst\\b",
      "\\bhate\\b",
      "\\bnot a\\b",
      "\\bwhy is\\b",
      "\\bthat'?s not\\b",
      "\\bthis is not\\b",
      "\\bcopyright",
      "\\blicen[cs]"
    ]
  },
  "spam": [
    "https?://",
    "www\\.",
    "\\bdm (us|me)\\b",
    "collab",
    "promot",
    "send (it|pic|this) to",
    "check (my|our) (page|profile|bio)",
    "followers",
    "ambassador",
    "\\bfeature\\b"
  ],
  "emoji_only": {
    "enabled": true,
    "_comment": "comment made only of emoji -> reply with one of these, no @mention",
    "replies": [
      "🫡",
      "🧨",
      "🚀",
      "🔥",
      "🙌",
      "🖤",
      "💯",
      "👏"
    ]
  }
}
